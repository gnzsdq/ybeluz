{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u79bb\u5a5a\u8bc1\u5236\u4f5c\u7528\u9014\uff0c\u529e\u7406\u79bb\u5a5a\u8bc1\u7684\u4f5c\u7528","text":"<p>\u5728\u9762\u5bf9\u5a5a\u59fb\u5173\u7cfb\u7684\u7ec8\u7ed3\u65f6\uff0c\u9886\u53d6\u79bb\u5a5a\u8bc1\u662f\u6cd5\u5b9a\u7684\u6700\u7ec8\u7a0b\u5e8f\u3002\u8bb8\u591a\u4eba\u8ba4\u4e3a\u79bb\u5a5a\u8bc1\u4ec5\u4ec5\u662f\u4e00\u5f20\u8bc1\u660e\u201c\u6062\u590d\u5355\u8eab\u201d\u7684\u7eb8\uff0c\u4f46\u4ece\u6cd5\u5f8b\u4e0e\u793e\u4f1a\u884c\u653f\u89d2\u5ea6\u6765\u770b\uff0c\u529e\u7406\u79bb\u5a5a\u8bc1\u7684\u4f5c\u7528\u8fdc\u4e0d\u6b62\u4e8e\u6b64\u3002\u65e0\u8bba\u662f\u8d2d\u4e70\u623f\u4ea7\u3001\u8d22\u4ea7\u5206\u5272\uff0c\u8fd8\u662f\u672a\u6765\u91cd\u65b0\u7ec4\u5efa\u5bb6\u5ead\uff0c\u79bb\u5a5a\u8bc1\u90fd\u5728\u5176\u4e2d\u626e\u6f14\u7740\u4e0d\u53ef\u6216\u7f3a\u7684\u6cd5\u5b9a\u89d2\u8272\u3002</p> <p></p> <p>\u672c\u6587\u5c06\u4e3a\u60a8\u6df1\u5ea6\u89e3\u6790\u79bb\u5a5a\u8bc1\u7684\u5b9e\u9645\u5236\u4f5c\u7528\u9014\u4e0e\u6838\u5fc3\u6cd5\u5f8b\u6548\u529b\uff0c\u5e2e\u52a9\u60a8\u5168\u9762\u4e86\u89e3\u8fd9\u4e00\u91cd\u8981\u8bc1\u4ef6\u7684\u5b9e\u9645\u4ef7\u503c\u3002</p>"},{"location":"#_2","title":"\u4e00\u3001 \u4ec0\u4e48\u662f\u79bb\u5a5a\u8bc1\uff1f\u5176\u6838\u5fc3\u6548\u529b\u662f\u4ec0\u4e48\uff1f","text":"<p>\u79bb\u5a5a\u8bc1\u662f\u6c11\u653f\u5c40\u5a5a\u59fb\u767b\u8bb0\u673a\u5173\u4f9d\u6cd5\u9881\u53d1\u7ed9\u5f53\u4e8b\u4eba\u7684\u6cd5\u5f8b\u6587\u4e66\uff0c\u7528\u4ee5\u8bc1\u660e\u592b\u59bb\u53cc\u65b9\u5df2\u7ecf\u6b63\u5f0f\u89e3\u9664\u5a5a\u59fb\u5173\u7cfb\u3002</p> <p>\u5728\u4e2d\u56fd\u6cd5\u5f8b\u6846\u67b6\u4e0b\uff0c\u89e3\u9664\u5a5a\u59fb\u5173\u7cfb\u53ea\u6709\u4e24\u79cd\u5408\u6cd5\u9014\u5f84\uff1a *   \u534f\u8bae\u79bb\u5a5a\uff1a \u53cc\u65b9\u8fbe\u6210\u4e00\u81f4\uff0c\u524d\u5f80\u6c11\u653f\u5c40\u767b\u8bb0\uff0c\u6700\u7ec8\u53d6\u5f97\u79bb\u5a5a\u8bc1\u3002 *   \u8bc9\u8bbc\u79bb\u5a5a\uff1a \u53cc\u65b9\u65e0\u6cd5\u8fbe\u6210\u4e00\u81f4\uff0c\u901a\u8fc7\u6cd5\u9662\u5224\u51b3\u6216\u8c03\u89e3\uff0c\u53d6\u5f97\u6cd5\u9662\u751f\u6548\u5224\u51b3\u4e66\u6216\u8c03\u89e3\u4e66\u3002</p> <p>\u56e0\u6b64\uff0c\u79bb\u5a5a\u8bc1\u662f\u534f\u8bae\u79bb\u5a5a\u5f53\u4e8b\u4eba\u5ba3\u544a\u5355\u8eab\u3001\u6062\u590d\u4eba\u8eab\u81ea\u7531\u7684\u76f4\u63a5\u6cd5\u5b9a\u51ed\u8bc1\u3002</p>"},{"location":"#_3","title":"\u4e8c\u3001 \u529e\u7406\u79bb\u5a5a\u8bc1\u7684\u6838\u5fc3\u4f5c\u7528\u4e0e\u5236\u4f5c\u7528\u9014","text":"<p>\u5728\u65e5\u5e38\u751f\u6d3b\u4e2d\uff0c\u79bb\u5a5a\u8bc1\u7684\u7528\u9014\u5e7f\u6cdb\u6e17\u900f\u4e8e\u884c\u653f\u3001\u91d1\u878d\u3001\u623f\u4ea7\u7b49\u591a\u4e2a\u9886\u57df\u3002\u4ee5\u4e0b\u662f\u529e\u7406\u79bb\u5a5a\u8bc1\u7684\u4e94\u5927\u6838\u5fc3\u4f5c\u7528\uff1a</p>"},{"location":"#1","title":"1. \u6062\u590d\u518d\u5a5a\u81ea\u7531\u7684\u6cd5\u5b9a\u51ed\u8bc1","text":"<p>\u6839\u636e\u6211\u56fd\u300a\u6c11\u6cd5\u5178\u300b\u89c4\u5b9a\uff0c\u5b9e\u884c\u4e00\u592b\u4e00\u59bb\u5236\u3002\u4efb\u4f55\u4eba\u82e5\u60f3\u91cd\u65b0\u767b\u8bb0\u7ed3\u5a5a\uff0c\u5fc5\u987b\u8bc1\u660e\u81ea\u5df1\u5f53\u524d\u5904\u4e8e\u65e0\u914d\u5076\u72b6\u6001\u3002\u79bb\u5a5a\u8bc1\u662f\u91cd\u65b0\u529e\u7406\u7ed3\u5a5a\u767b\u8bb0\u65f6\uff0c\u5a5a\u59fb\u767b\u8bb0\u673a\u5173\u8981\u6c42\u63d0\u4ea4\u7684\u6838\u5fc3\u6750\u6599\u3002\u5982\u679c\u6ca1\u6709\u79bb\u5a5a\u8bc1\uff0c\u5c06\u65e0\u6cd5\u8fdb\u884c\u5408\u6cd5\u7684\u4e8c\u6b21\u767b\u8bb0\u3002</p>"},{"location":"#2","title":"2. \u8d22\u4ea7\u5206\u5272\u4e0e\u4ea7\u6743\u53d8\u66f4\u7684\u4f9d\u636e","text":"<p>\u867d\u7136\u79bb\u5a5a\u534f\u8bae\u4e66\u8be6\u7ec6\u8bb0\u5f55\u4e86\u8d22\u4ea7\u5206\u5272\u65b9\u6848\uff0c\u4f46\u5728\u5b9e\u9645\u529e\u7406\u4ea7\u6743\u53d8\u66f4\uff08\u5982\u623f\u4ea7\u8fc7\u6237\u3001\u8f66\u8f86\u66f4\u540d\u3001\u516c\u53f8\u80a1\u6743\u53d8\u66f4\uff09\u65f6\uff0c\u623f\u7ba1\u5c40\u6216\u5de5\u5546\u5c40\u7b49\u884c\u653f\u90e8\u95e8\u901a\u5e38\u9700\u8981\u5f53\u4e8b\u4eba\u51fa\u793a\u79bb\u5a5a\u8bc1\uff0c\u4ee5\u8bc1\u660e\u8be5\u79bb\u5a5a\u534f\u8bae\u5df2\u7ecf\u6b63\u5f0f\u751f\u6548\uff0c\u4ece\u800c\u5408\u89c4\u529e\u7406\u8d44\u4ea7\u8f6c\u79fb\u3002</p>"},{"location":"#3","title":"3. \u623f\u4ea7\u4ea4\u6613\u4e0e\u9650\u8d2d\u653f\u7b56\u5ba1\u67e5","text":"<p>\u5728\u8bb8\u591a\u4e00\u4e8c\u7ebf\u57ce\u5e02\uff0c\u623f\u4ea7\u9650\u8d2d\u653f\u7b56\u4e0e\u5bb6\u5ead\u6237\u7c4d\u3001\u5a5a\u59fb\u72b6\u6001\u7d27\u5bc6\u6302\u94a9\u3002\u65e0\u8bba\u662f\u4eab\u53d7\u9996\u5957\u623f\u5951\u7a0e\u4f18\u60e0\u3001\u7533\u8bf7\u516c\u79ef\u91d1\u8d37\u6b3e\uff0c\u8fd8\u662f\u5728\u9650\u8d2d\u57ce\u5e02\u8d2d\u623f\uff0c\u94f6\u884c\u548c\u623f\u4ea7\u4ea4\u6613\u4e2d\u5fc3\u90fd\u9700\u8981\u5ba1\u67e5\u5f53\u4e8b\u4eba\u7684\u5a5a\u59fb\u72b6\u51b5\u3002\u6b64\u65f6\uff0c\u79bb\u5a5a\u8bc1\u662f\u8bc1\u660e\u201c\u72ec\u7acb\u5bb6\u5ead\u201d\u6216\u201c\u5355\u8eab\u72b6\u6001\u201d\u7684\u91cd\u8981\u5ba1\u6838\u4f9d\u636e\u3002</p>"},{"location":"#4","title":"4. \u6237\u53e3\u8fc1\u79fb\u4e0e\u53d8\u66f4","text":"<p>\u79bb\u5a5a\u540e\uff0c\u5f80\u5f80\u6d89\u53ca\u5230\u6237\u53e3\u4ece\u5bf9\u65b9\u5bb6\u5ead\u8fc1\u51fa\u6216\u72ec\u7acb\u7acb\u6237\u7684\u60c5\u51b5\u3002\u524d\u5f80\u516c\u5b89\u6d3e\u51fa\u6240\u529e\u7406\u6237\u53e3\u8fc1\u79fb\u3001\u5c06\u6237\u53e3\u672c\u4e0a\u7684\u201c\u5a5a\u59fb\u72b6\u51b5\u201d\u7531\u201c\u5df2\u5a5a\u201d\u66f4\u6539\u4e3a\u201c\u79bb\u5a5a\u201d\u65f6\uff0c\u5fc5\u987b\u51fa\u793a\u79bb\u5a5a\u8bc1\u539f\u4ef6\u3002</p>"},{"location":"#5","title":"5. \u6d89\u5916\u4e8b\u52a1\u4e0e\u79fb\u6c11\u7559\u5b66\u7b7e\u8bc1","text":"<p>\u5728\u7533\u8bf7\u67d0\u4e9b\u56fd\u5bb6\u7684\u7b7e\u8bc1\u3001\u529e\u7406\u6d89\u5916\u79fb\u6c11\u6216\u7559\u5b66\u624b\u7eed\u65f6\uff0c\u5927\u4f7f\u9986\u901a\u5e38\u8981\u6c42\u7533\u8bf7\u4eba\u63d0\u4f9b\u5a5a\u59fb\u72b6\u51b5\u8bc1\u660e\u3002\u82e5\u5c5e\u4e8e\u79bb\u5f02\u72b6\u6001\uff0c\u5fc5\u987b\u63d0\u4ea4\u79bb\u5a5a\u8bc1\uff0c\u5e76\u5f80\u5f80\u9700\u8981\u7ecf\u8fc7\u516c\u8bc1\u5904\u8fdb\u884c\u79bb\u5a5a\u8bc1\u516c\u8bc1\u53ca\u53cc\u8ba4\u8bc1\uff0c\u65b9\u53ef\u5728\u56fd\u5916\u5177\u5907\u6cd5\u5f8b\u6548\u529b\u3002</p>"},{"location":"#_4","title":"\u4e09\u3001 \u5173\u4e8e\u201c\u79bb\u5a5a\u8bc1\u6837\u672c\u201d\u4e0e\u771f\u4f2a\u8fa8\u522b","text":"<p>\u5728\u8c37\u6b4c\u56fe\u7247\u7b49\u641c\u7d22\u5f15\u64ce\u4e2d\uff0c\u8bb8\u591a\u4eba\u4f1a\u641c\u7d22\u79bb\u5a5a\u8bc1\u6837\u672c\u6765\u4e86\u89e3\u5176\u6392\u7248\u3001\u5b57\u6837\u548c\u9632\u4f2a\u6807\u8bc6\u3002\u968f\u7740\u653f\u52a1\u6570\u5b57\u5316\u7684\u63a8\u8fdb\uff0c\u73b0\u4ee3\u79bb\u5a5a\u8bc1\u5df2\u7ecf\u5177\u5907\u4e86\u6781\u9ad8\u7684\u9632\u4f2a\u6280\u672f\uff1a</p> <ul> <li>\u5916\u89c2\u7279\u5f81\uff1a \u76ee\u524d\u4e2d\u56fd\u5185\u5730\u7684\u79bb\u5a5a\u8bc1\u5c01\u9762\u901a\u5e38\u4e3a\u7edb\u7ea2\u8272\uff08\u4fd7\u79f0\u7d2b\u8272\u6216\u6df1\u7ea2\u8272\uff09\uff0c\u5370\u6709\u56fd\u5fbd\u53ca\u201c\u79bb\u5a5a\u8bc1\u201d\u5b57\u6837\uff08\u800c\u7ed3\u5a5a\u8bc1\u4e3a\u6b63\u7ea2\u8272\uff09\u3002</li> <li>\u5185\u9875\u4fe1\u606f\uff1a \u5305\u542b\u53cc\u65b9\u59d3\u540d\u3001\u6027\u522b\u3001\u56fd\u7c4d\u3001\u51fa\u751f\u65e5\u671f\u3001\u8eab\u4efd\u8bc1\u53f7\u3001\u79bb\u5a5a\u767b\u8bb0\u65e5\u671f\u3001\u8bc1\u4ef6\u53f7\uff0c\u5e76\u52a0\u76d6\u5a5a\u59fb\u767b\u8bb0\u673a\u5173\u7684\u5370\u7ae0\u3002</li> <li>\u6570\u5b57\u5316\u67e5\u9a8c\uff1a \u5982\u4eca\uff0c\u56fd\u5bb6\u653f\u52a1\u670d\u52a1\u5e73\u53f0\u53ca\u5404\u7701\u5e02\u7684\u653f\u52a1App\uff08\u5982\u7ca4\u7701\u4e8b\u3001\u968f\u7533\u529e\u7b49\uff09\u5747\u5df2\u4e0a\u7ebf\u7535\u5b50\u79bb\u5a5a\u8bc1\u3002\u4efb\u4f55\u673a\u6784\u5728\u5ba1\u67e5\u65f6\uff0c\u5747\u53ef\u901a\u8fc7\u5b98\u65b9\u7cfb\u7edf\u8054\u7f51\u6838\u9a8c\u771f\u4f2a\u3002</li> </ul> <p>\u90d1\u91cd\u63d0\u793a\uff1a \u79bb\u5a5a\u8bc1\u5fc5\u987b\u7531\u56fd\u5bb6\u5408\u6cd5\u7684\u6c11\u653f\u90e8\u95e8\u4f9d\u6cd5\u9881\u53d1\u3002\u4efb\u4f55\u79c1\u81ea\u4f2a\u9020\u3001\u4e70\u5356\u6216\u4f7f\u7528\u5047\u79bb\u5a5a\u8bc1\u7684\u884c\u4e3a\uff0c\u5747\u89e6\u72af\u300a\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u6cbb\u5b89\u7ba1\u7406\u5904\u7f5a\u6cd5\u300b\u6216\u300a\u5211\u6cd5\u300b\uff0c\u5c5e\u4e8e\u8fdd\u6cd5\u72af\u7f6a\u884c\u4e3a\uff0c\u5207\u52ff\u4ee5\u8eab\u8bd5\u6cd5\u3002</p>"},{"location":"#_5","title":"\u56db\u3001 \u603b\u7ed3","text":"<p>\u603b\u7ed3\u6765\u8bf4\uff0c\u529e\u7406\u79bb\u5a5a\u8bc1\u7684\u4f5c\u7528\u4e0d\u4ec5\u5728\u4e8e\u7ed9\u8fc7\u53bb\u4e00\u6bb5\u60c5\u611f\u753b\u4e0a\u53e5\u53f7\uff0c\u66f4\u5728\u4e8e\u786e\u7acb\u5168\u65b0\u7684\u6cd5\u5f8b\u8eab\u4efd\u3002\u4ece\u623f\u4ea7\u8fc7\u6237\u3001\u518d\u5a5a\u767b\u8bb0\u5230\u6d89\u5916\u516c\u8bc1\uff0c\u79bb\u5a5a\u8bc1\u90fd\u662f\u4e0d\u53ef\u6216\u7f3a\u7684\u5e95\u724c\u3002\u59a5\u5584\u4fdd\u7ba1\u597d\u79bb\u5a5a\u8bc1\uff0c\u5e76\u5728\u9700\u8981\u65f6\u901a\u8fc7\u6b63\u89c4\u653f\u52a1\u6e20\u9053\u51fa\u793a\u6216\u6838\u9a8c\uff0c\u624d\u80fd\u4f9d\u6cd5\u4fdd\u969c\u81ea\u8eab\u7684\u5408\u6cd5\u6743\u76ca\u3002</p>"}]}